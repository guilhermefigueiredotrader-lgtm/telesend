# Token do seu bot, recebido do @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExemploDoToken

# ID do canal/grupo para onde as mensagens serão enviadas
# Exemplos: -1001234567890  ou  @meucanal (se o canal for público)
TELEGRAM_CHAT_ID=-1001234567890

# (Opcional) Senha para proteger o acesso ao site. Deixe em branco para não usar senha.
SITE_PASSWORD=
